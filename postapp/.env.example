# ─────────────────────────────────────────────────────────
# PostKnob — environment variable template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control!
# ─────────────────────────────────────────────────────────

# Django core
SECRET_KEY=django-insecure-replace-me-with-a-secure-random-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (leave blank to use SQLite in development)
# For PostgreSQL: DATABASE_URL=postgresql://user:password@localhost:5432/postknob_db
DATABASE_URL=

# Redis
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0

# Cloudinary (optional — leave blank to use local media storage)
CLOUDINARY_URL=

# Sentry (optional — leave blank to disable)
SENTRY_DSN=

# CORS — comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Email (production only)
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@postknob.app
